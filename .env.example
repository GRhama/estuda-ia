# LLM — set MODEL to gemini-2.0-flash to use Gemini (1500 req/day free)
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=
MODEL=claude-sonnet-4-20250514

# RAG
EMBEDDING_MODEL=all-MiniLM-L6-v2
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=change-me-strong-key

# Rate Limit
RATE_LIMIT_FREE=5
