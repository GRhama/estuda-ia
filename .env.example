DAILY_COST_CAP_USD=5.00

# Token Budget
MAX_TOKENS_RESUMO=3000
MAX_TOKENS_REDACAO=5000
MAX_TOKENS_DPO=6000
MAX_TOKENS_ANALISE=4500
MAX_TOKENS_FICHA=12000

# Observabilidade (opcional)
LANGCHAIN_TRACING_V2=false
