:80 {
    # Static PWA
    handle /manifest.json {
        root * /srv/frontend
        file_server
    }
    handle /sw.js {
        root * /srv/frontend
        file_server
    }
    handle /icon-*.png {
        root * /srv/frontend
        file_server
    }
    handle /pesquisar* {
        reverse_proxy api:8000 {
            flush_interval -1
            header_up Host {host}
            header_up X-Real-IP {remote_host}
        }
    }
    handle /health {
        reverse_proxy api:8000
    }
    handle {
        root * /srv/frontend
        file_server
        try_files {path} /index.html
    }
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        -Server
    }
    encode gzip
    log {
        output stderr
        level ERROR
    }
}
